<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hydrio_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hydrio"
            android:textColor="#075985"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13%"
            android:textColor="#0369A1"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="250 ml"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="de 2000 ml"
        android:textColor="#64748B"
        android:textSize="10sp" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="13"
        android:progressDrawable="@drawable/hydrio_widget_progress" />

    <TextView
        android:id="@+id/widget_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Faltam 1750 ml"
        android:textColor="#475569"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_add_100"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_add_250"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_add_500"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>
